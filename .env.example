# Gemini Enterprise: authenticate locally with `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Hosted deployments: store a service-account JSON document as a sealed secret,
# not in a file or frontend variable. Local development uses Application Default Credentials.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ClickHouse Cloud connection details. Keep real values in your hosting provider's secret store.
CLICKHOUSE_HOST=your-clickhouse-host
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-me
CLICKHOUSE_DATABASE=story_is_straight
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
# The production Docker runtime starts the official mcp-clickhouse sidecar locally.
# Keep this token private; it is only used between the Node API and localhost MCP.
CLICKHOUSE_MCP_AUTH_TOKEN=replace-with-a-long-random-token
CLICKHOUSE_MCP_URL=http://127.0.0.1:8000/mcp

# Production app/API port.
AGENT_PORT=8787
CLOUD_REVIEW_RATE_LIMIT=5
